+// ## r8 GRPFOLD (kda-sm90 round 8, accumulation-order class, NOT bitwise): independent group PV accumulators.
+// Products k = 0 .. 4*kPVNSplit-1 (slab k/4, group k%4) each go into a ZERO-INIT half-width temp T[k%2] (32 fp32
+// regs), are retired by warpgroup_wait<1> one issue later, and folded into tOrO's slab with fmaf(T, w_g, O),
+// w_g = v8sc_g * 2^(ms_g - m*l2) (softmax.basis<g>), in ascending group order per slab; no Horner rho chain.
+// Ledger per step k: issue(k) -> wait<1> (retires k-1) -> fold(k-1).  T[k%2] was folded at step k-1 before
+// issue(k) reuses it.  The last product (slab kPVNSplit-1, group 3, temp T[1] = the caller's tOrD) stays in flight
+// to the caller's wait<0> + fq8_promote_last (basis_last = basis<3>), exactly as shipped.
+#define GF_ISSUE(K, T)                                                                                                \
+    fq8_gemm_krange</*zero_init=*/true, /*wg_wait=*/-1, ((K) % 4) * kAtomsPerGroup, ((K) % 4 + 1) * kAtomsPerGroup>(  \
+        tiled_mma_pv, tOrP, pv_B_slab(cute::Int<(K) / 4>{}, gf_vst), T);
+#define GF_FOLD(K, T)                                                                                \
+    { warpgroup_wait<1>(); warpgroup_fence_operand(T); auto gfO_ = pv_O_slab(cute::Int<(K) / 4>{});  \
+      softmax.promote_o(gfO_, T, fq8_gw[(K) % 4]); }
+#define GF_STEP(K, TK, TP) if constexpr ((K) < 4 * kPVNSplit) { GF_ISSUE(K, TK) GF_FOLD((K) - 1, TP) }
+#define GRPFOLD_TILE(VSTAGE, DLAST)                                                                                             \
+    {                                                                                                                           \
+        static_assert(kGroups == 4 && (kPVNSplit == 2 || kPVNSplit == 4), "GRPFOLD: four groups, two or four slabs");           \
+        auto gf_vst = VSTAGE;                                                                                                   \
+        auto gf_t0 = make_tOrD();                                                                                               \
+        typename Softmax::TensorT const fq8_gw[4] = {softmax.template basis<0>(fq8_v[0]), softmax.template basis<1>(fq8_v[1]),  \
+                                                    softmax.template basis<2>(fq8_v[2]), softmax.template basis<3>(fq8_v[3])};  \
+        GF_ISSUE(0, gf_t0)                                                                                                      \
+        GF_STEP(1, DLAST, gf_t0) GF_STEP(2, gf_t0, DLAST) GF_STEP(3, DLAST, gf_t0) GF_STEP(4, gf_t0, DLAST)                     \
+        GF_STEP(5, DLAST, gf_t0) GF_STEP(6, gf_t0, DLAST) GF_STEP(7, DLAST, gf_t0) GF_STEP(8, gf_t0, DLAST)                     \
+        GF_STEP(9, DLAST, gf_t0) GF_STEP(10, gf_t0, DLAST) GF_STEP(11, DLAST, gf_t0) GF_STEP(12, gf_t0, DLAST)                  \
+        GF_STEP(13, DLAST, gf_t0) GF_STEP(14, gf_t0, DLAST) GF_STEP(15, DLAST, gf_t0)                                           \
     }
             auto fq8_pv_tile = [&](auto tOrV_stage, auto& D_) {
