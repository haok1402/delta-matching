+def _strided_or_reference(sig, strided_fn, reference_fn):
+    """Run the strided path; on the first use of `sig` also run the contiguous reference route and keep the strided
+    path only if every output is bitwise equal (else warn and use the reference for this signature)."""
+    if not STRIDED or _strided_ok.get(sig) is False:
+        return reference_fn()
+    out = strided_fn()
+    if sig not in _strided_ok:
+        ref = reference_fn()
+        ok = all(torch.equal(a.view(torch.uint8) if a.element_size() == 1 else a,
+                             b.view(torch.uint8) if b.element_size() == 1 else b) for a, b in zip(out, ref))
+        _strided_ok[sig] = ok
+        if not ok:
+            warnings.warn(f"delta_matching: the strided producer differs from the contiguous route at {sig}; "
+                          "using the contiguous route for this signature", RuntimeWarning)
+            return ref
+    return out
+
