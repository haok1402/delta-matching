@@ -1684,7 +1732,20 @@ struct CollectiveMainloopFwdSm90Fp8F {
                     warp_scheduler_barrier_sync();
                     KF(2);
                     auto tOrD = make_tOrD();
-                    fq8_pv_tile(tOrV(_, _, _, smem_pipe_read_v.index()), tOrD);
+                    if constexpr (kPVIL) {
+                        static_assert(kGroups == 4 && kGroupsPerPromote == 4 && (kPVNSplit == 2 || kPVNSplit == 4),
+                                      "PVIL: four groups per tile, one promote per tile, two or four slabs");
+                        auto tOrV_st = tOrV(_, _, _, smem_pipe_read_v.index());
+                        auto tOrDx = make_tOrD();
+                        if constexpr (kPVNSplit == 2) {
+                            FQ8_PV_PAIR_APG(cute::Int<0>{}, cute::Int<1>{}, tOrV_st, true, tOrDx, tOrD)
+                        } else {
+                            FQ8_PV_PAIR_APG(cute::Int<0>{}, cute::Int<1>{}, tOrV_st, false, tOrDx, tOrD)
+                            FQ8_PV_PAIR_APG(cute::Int<2>{}, cute::Int<3>{}, tOrV_st, true, tOrDx, tOrD)
+                        }
+                    } else {
+                        fq8_pv_tile(tOrV(_, _, _, smem_pipe_read_v.index()), tOrD);
+                    }
                     KF(3);
                     warpgroup_wait<0>();
                     KF(4);
