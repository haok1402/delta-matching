+// ## r7 PVIL (kda-sm90 round 7, scheduling only, bitwise): FWDIL2's interleaved pair generalised to kAtomsPerGroup
+// k-atoms per group (2 at hd128 F3, 1 at d256).  Two half-width temps Da / Db (one head-dim slab each) run as two rho
+// chains: while one temp's group-g gemm is in flight the other temp's group-(g-1) result is rescaled by rho_g, so the
+// rescale FMULs leave the tensor-core critical path.  Each temp sees exactly the shipped op sequence on its own
+// elements (zero-init g0, rho1, g1, rho2, g2, rho3, g3, promote with basis_last); rho_g / w3 are per-row scalars
+// shared by the slabs; a wgmma output element does not depend on the atom's N width.
+#define FQ8_PV_PAIR_APG(NA_C, NB_C, VSTAGE, DEFERB, Da, Db)                                                 \
+    {                                                                                                       \
+        constexpr int A_ = kAtomsPerGroup;                                                                  \
+        auto Ba_ = pv_B_slab(NA_C, VSTAGE);                                                                 \
+        auto Bb_ = pv_B_slab(NB_C, VSTAGE);                                                                 \
+        auto Oa_ = pv_O_slab(NA_C);                                                                         \
+        fq8_gemm_krange</*zero_init=*/true,  /*wg_wait=*/-1, 0 * A_, 1 * A_>(tiled_mma_pv, tOrP, Ba_, Da);  \
+        fq8_gemm_krange</*zero_init=*/true,  /*wg_wait=*/-1, 0 * A_, 1 * A_>(tiled_mma_pv, tOrP, Bb_, Db);  \
+        auto rho1_ = fq8_rho(softmax, 1);                                                                   \
+        warpgroup_wait<1>(); warpgroup_fence_operand(Da);                                                   \
+        softmax.rescale_o(Da, rho1_);                                                                       \
+        fq8_gemm_krange</*zero_init=*/false, /*wg_wait=*/-1, 1 * A_, 2 * A_>(tiled_mma_pv, tOrP, Ba_, Da);  \
+        warpgroup_wait<1>(); warpgroup_fence_operand(Db);                                                   \
+        softmax.rescale_o(Db, rho1_);                                                                       \
+        fq8_gemm_krange</*zero_init=*/false, /*wg_wait=*/-1, 1 * A_, 2 * A_>(tiled_mma_pv, tOrP, Bb_, Db);  \
+        auto rho2_ = fq8_rho(softmax, 2);                                                                   \
+        warpgroup_wait<1>(); warpgroup_fence_operand(Da);                                                   \
+        softmax.rescale_o(Da, rho2_);                                                                       \
+        fq8_gemm_krange</*zero_init=*/false, /*wg_wait=*/-1, 2 * A_, 3 * A_>(tiled_mma_pv, tOrP, Ba_, Da);  \
+        warpgroup_wait<1>(); warpgroup_fence_operand(Db);                                                   \
+        softmax.rescale_o(Db, rho2_);                                                                       \
+        fq8_gemm_krange</*zero_init=*/false, /*wg_wait=*/-1, 2 * A_, 3 * A_>(tiled_mma_pv, tOrP, Bb_, Db);  \
+        auto rho3_ = fq8_rho(softmax, 3);                                                                   \
+        warpgroup_wait<1>(); warpgroup_fence_operand(Da);                                                   \
+        softmax.rescale_o(Da, rho3_);                                                                       \
+        fq8_gemm_krange</*zero_init=*/false, /*wg_wait=*/-1, 3 * A_, 4 * A_>(tiled_mma_pv, tOrP, Ba_, Da);  \
+        warpgroup_wait<1>(); warpgroup_fence_operand(Db);                                                   \
+        softmax.rescale_o(Db, rho3_);                                                                       \
+        fq8_gemm_krange</*zero_init=*/false, /*wg_wait=*/-1, 3 * A_, 4 * A_>(tiled_mma_pv, tOrP, Bb_, Db);  \
+        warpgroup_wait<1>(); warpgroup_fence_operand(Da);                                                   \
+        softmax.promote_o(Oa_, Da, softmax.basis_last(fq8_v[3]));                                           \
+        if constexpr (!(DEFERB)) {                                                                          \
+            warpgroup_wait<0>(); warpgroup_fence_operand(Db);                                               \
+            auto Ob_ = pv_O_slab(NB_C);                                                                     \
+            softmax.promote_o(Ob_, Db, softmax.basis_last(fq8_v[3]));                                       \
+        }                                                                                                   \
     }
             auto fq8_pv_tile = [&](auto tOrV_stage, auto& D_) {
